#!/bin/sh
# =============================================================================
#  Garde-fou FILI — pre-commit
#
#  Un crash-test qu'on doit se souvenir de lancer cède exactement au moment où
#  il compte : la veille d'une livraison. Ce hook le lance à notre place.
#
#  Volontairement sans husky ni lint-staged : le garde-fou ne doit pas dépendre
#  d'une dépendance qu'un `npm ci` raté ferait disparaître en silence.
#
#  Activation (une fois) :  git config core.hooksPath .githooks
#  Contournement assumé  :  git commit --no-verify   → à déclarer au journal.
# =============================================================================

set -e

echo "── Garde-fou Fili ───────────────────────────────────────────"

# L'app témoin vit dans temoin/ depuis le rangement du 2026-08-23.
cd "$(git rev-parse --show-toplevel)/temoin"

# S2 tourne toujours : zéro dépendance, donc jamais d'excuse pour le sauter.
# --no-build évite deux builds complets à chaque commit ; T8 reste alors
# BLOQUÉ, donc jamais compté comme PASS. Le build reproductible se vérifie
# en intégration, pas à chaque sauvegarde.
node scripts/qpm-s2.mjs --no-build

if [ -d node_modules ]; then
  npx --no-install tsc -b --noEmit
  npx --no-install eslint .
else
  echo "  ⚠  node_modules absent — lint et typecheck sautés."
  echo "     Le commit passe, mais la preuve est incomplète : npm install."
fi

# ── Le kit : l'état du banc, dit à chaque enregistrement ─────────────────────
#
# Ce bloc NE lance PAS le banc (deux minutes et un navigateur : ce serait un
# verrou, et le verrou n'a pas été retenu). Il compare deux dates — quand la
# page a bougé, quand son épreuve est passée au vert — et rabat le 🟢 de la
# carte à 🟡 quand la première est plus récente que la seconde. Il ne refuse
# jamais un enregistrement : c'est un voyant.
#
# Il ne corrige la carte que si personne d'autre n'y écrit ; sinon il se
# contente de parler, pour ne pas mêler sa correction au travail en cours.

RACINE_FILI="$(git rev-parse --show-toplevel)"
if git diff --quiet -- docs/system-map.md 2>/dev/null \
   && git diff --cached --quiet -- docs/system-map.md 2>/dev/null; then
  node "$RACINE_FILI/kit/epreuves/etat-du-banc.mjs" --ecrire || true
else
  node "$RACINE_FILI/kit/epreuves/etat-du-banc.mjs" || true
fi

echo "── OK ───────────────────────────────────────────────────────"
