<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  MODÈLE — ne pas installer ce fichier à la main.

  Un rendez-vous lancé par macOS n'hérite pas de ton terminal : il ne trouve ni
  node ni npm, et la course meurt sur « command not found: node ». Les chemins
  doivent être résolus depuis TON environnement, une fois, à l'installation.

  C'est ce que fait, depuis la racine du dépôt :

      sh kit/tests/install-the-run.sh

  Il écrit le vrai rendez-vous dans ~/Library/LaunchAgents/ avec le chemin exact
  de node et ton PATH, puis le déclare à macOS. Ce fichier-ci ne sert qu'à
  montrer sa forme.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>fr.fili.banc-de-nuit</string>

  <key>ProgramArguments</key>
  <array>
    <string>CHEMIN/ABSOLU/DE/node</string>
    <string>RACINE/DU/DEPOT/kit/tests/night-run.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>RACINE/DU/DEPOT</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>LE PATH DU TERMINAL D'AUTEUR — npm en dépend</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
