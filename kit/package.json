{
  "name": "kit",
  "private": true,
  "version": "0.1.0",
  "description": "Le kit neuf — fondations d'abord, chaque élément montre ses lois. L'existant (sources/) est la carrière ; le normatif est la règle et le jeton, toute implémentation n'est qu'un exemple.",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "tokens": "node tokens.ecrire.mjs",
    "test": "node --test derivation.test.mjs",
    "test:pages": "KIT_DIST=.next-epreuves next build && KIT_DIST=.next-epreuves node --test 'epreuves/*.test.mjs'"
  },
  "dependencies": {
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.2"
  }
}
