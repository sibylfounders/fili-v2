{
  "name": "fili-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "hooks": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "qpm:s2": "node scripts/qpm-s2.mjs",
    "qpm:s2:mutate": "node scripts/qpm-s2.mjs --mutate",
    "qpm": "npm run fili:crash-test && npm run fili:journal && npm run fili:contrastes && npm run lint",
    "fili:crash-test": "node tools/fili/crash-test/run.mjs",
    "fili:mutations": "node tools/fili/crash-test/mutations.mjs",
    "fili:integrite": "node tools/fili/crash-test/integrite.mjs",
    "fili:expression": "node scripts/generer-expression.mjs && node scripts/generer-libelles.mjs",
    "fili:contrastes": "node tools/fili/expression/contrastes.mjs",
    "fili:journal": "node tools/fili/journal/immuable.mjs",
    "fili:etat": "node tools/fili/etat/produire.mjs",
    "fili:temoin": "node tools/fili/temoin/rendu.mjs",
    "fili:temoins": "node tools/fili/temoin/rendu-produit.mjs",
    "fili:check": "eslint src",
    "fili:catalogue": "node tools/fili/expression/catalogue.mjs",
    "fili:systeme": "node tools/fili/systeme/produire.mjs",
    "fili:lexique": "node tools/fili/lexique/produire.mjs",
    "fili:regles": "node tools/fili/regles/produire.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.10.3",
    "eslint": "^9.25.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "globals": "^16.0.0",
    "lucide-static": "^1.30.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.5"
  }
}
