      "inline-coque",
      "inline-carte",
      "inline-detail",
      "block-large",
      "block-page",
      "block-coque",
      "block-carte",
      "block-detail"
    ],
    "exceptions": [
      "mx-auto"
    ],
    "proximite": {
      "$source": "Le facteur suivait un seuil posé de l'extérieur (3). Il suit désormais le ratio de l'Échelle : deux profondeurs voisines en sont séparées par construction, et 3 n'était atteignable sous aucun réglage — le ratio est borné à 2,2.",
      "facteur": 1.4142135623730951,
      "tolerance": 0.01,
      "propEspace": "espace",
      "conteneurs": [
        "Pile",
        "Grille"
      ]
    },
    "pixels": {
      "$comment": "Valeurs de socle, hors multiplicateur responsive : le multiplicateur est commun à tous les jetons d'un même axe, donc le rapport que R3.7 juge est le même à toutes les largeurs.",
      "marges": {
