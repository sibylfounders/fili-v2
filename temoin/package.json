{
  "name": "fili-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "hooks": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "qpm:s2": "node scripts/qpm-s2.mjs",
    "qpm:s2:mutate": "node scripts/qpm-s2.mjs --mutate",
    "qpm": "npm run fili:crash-test && npm run fili:journal && npm run fili:contrastes && npm run lint",
    "fili:crash-test": "node tools/fili/crash-test/run.mjs",
    "fili:mutations": "node tools/fili/crash-test/mutations.mjs",
    "fili:integrity": "node tools/fili/crash-test/integrity.mjs",
    "fili:expression": "node scripts/generate-expression.mjs && node scripts/generate-labels.mjs",
    "fili:contrasts": "node tools/fili/expression/contrasts.mjs",
    "fili:journal": "node tools/fili/journal/immutable.mjs",
    "fili:state": "node tools/fili/state/produce.mjs",
    "fili:witness": "node tools/fili/witness/render.mjs",
    "fili:witnesses": "node tools/fili/witness/render-product.mjs",
    "fili:check": "eslint src",
    "fili:catalog": "node tools/fili/expression/catalog.mjs",
    "fili:system": "node tools/fili/system/produce.mjs",
    "fili:lexicon": "node tools/fili/lexicon/produce.mjs",
    "fili:rules": "node tools/fili/rules/produce.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "axis-core": "^4.10.3",
    "eslint": "^9.25.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "globals": "^16.0.0",
    "lucide-static": "^1.30.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.5"
  }
}
